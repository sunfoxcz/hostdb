# Keep Host names distinct from Ansible group names stored in hostdb.
Host switch-01
    HostName 192.0.2.85
    User root
    PasswordAuthentication yes
    KexAlgorithms +diffie-hellman-group1-sha1
    HostKeyAlgorithms +ssh-rsa
    MACs hmac-sha1
    Ciphers aes128-ctr

Host router-01
    HostName 198.51.100.20
    Port 2222
    User netops
    PubkeyAcceptedAlgorithms +ssh-rsa

Host app-ssh
    HostName app-server.example.com
    User root
